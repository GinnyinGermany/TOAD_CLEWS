{
    "model": "GFDL-ESM4",
    "variable_settings": {
        "cVeg": {
            "preprocessing": {
                "type": "simple",
                "time_frequency": "1YS",
                "aggregation": "mean",
                "unit_conversion": "none",
                "rolling_years": 5
            },
            "plot": {
                "color": "forestgreen",
                "ylabel": "Mean Vegetation Carbon ($kgC/m^2$)",
                "cmap": "YlGn",
                "label": "Vegetation Carbon ($kgC/m^2$)"
            },
            "toad": {
                "shift":{
                     "shift_method": "ASDETECT",
                     "shift_direction": "negative",
                     "shift_selection": "local" },
                "cluster":{
                    "cluster_method": "SpaceTimeDBSCAN",
                    "optimize": true,
                    "optimize_objective": "combined_spatial_nonlinearity",
                    "optimize_params": {
                    "spatial_eps": [100, 1500.0],
                    "temporal_eps": [0.1,1.5],
                    "min_samples": [15,50] },
                    "optimize_n_trials": 3000}
            }
        },
        "MCWD": {
            "preprocessing": {
                "type": "custom",
                "formula_id": "MCWD_hydrological_year",
                "inputs": ["pr", "evspsbl"],
                "time_frequency": "1YS",
                "unit_conversion": "flux_to_monthly_mm",
                "rolling_years": 10
            },
            "plot": {
                "color": "goldenrod",
                "ylabel": "Mean Max Cumulative Water Deficit ($mm$)",
                "cmap": "YlGnBu",
                "label": "Max Cumulative Water Deficit ($mm$)"
            },
            "toad": {
                "shift":{
                     "shift_method": "ASDETECT",
                     "shift_direction": "negative",
                     "shift_selection": "local" },
                "cluster":{
                    "cluster_method": "SpaceTimeDBSCAN",
                    "optimize": true,
                    "optimize_objective": "mean_spatial_autocorrelation",
                    "optimize_params": {
                    "spatial_eps": [500.0,2000.0],
                    "temporal_eps": [0.1,2.0],
                    "min_samples": [5,50] },
                    "optimize_n_trials": 3000}
            }
        },
        "fFire": {
            "preprocessing": {
                "type": "simple",
                "time_frequency": "1YS",
                "aggregation": "sum",
                "unit_conversion": "flux_to_annual_total",
                "rolling_years": 10

            },
            "plot": {
                "color": "firebrick",
                "ylabel": "Mean Fire CO$_2$ Emission ($kgC/m^2/yr$)",
                "cmap": "Reds",
                "label": "Fire CO$_2$ Emission ($kgC/m^2/yr$)"
            },
            "toad": {
                "shift":{
                     "shift_method": "ASDETECT",
                     "shift_direction": "positive",
                     "shift_selection": "local" },
                "cluster":{
                    "cluster_method": "SpaceTimeDBSCAN",
                    "optimize": true,
                    "optimize_objective": "combined_spatial_nonlinearity",
                    "optimize_params": {
                    "spatial_eps": [300.0,1000.0],
                    "temporal_eps": [0.2,0.8],
                    "min_samples": [3,50] },
                    "optimize_n_trials": 3000}
            }
        },
        "grassFrac": {
            "preprocessing": {
                "type": "simple",
                "time_frequency": "1YS",
                "aggregation": "mean",
                "unit_conversion": "none",
                "rolling_years": 5
            },
            "plot": {
                "color": "limegreen",
                "ylabel": "Mean Grass Area (%)",
                "cmap": "YlGn",
                "label": "Grass Area (%)"
            },
            "toad": {
                "shift":{
                     "shift_method": "ASDETECT",
                     "shift_direction": "positive",
                     "shift_selection": "local"
                    },
                "cluster":{
                    "cluster_method": "SpaceTimeDBSCAN",
                    "optimize": true,
                    "optimize_objective": "mean_spatial_autocorrelation",
                    "optimize_params": {
                    "spatial_eps": [300.0,1000.0],
                    "temporal_eps": [0.5,1.5],
                    "min_samples": [5,50] },
                    "optimize_n_trials": 3000}
                }
        },
        "treeFrac": {
            "preprocessing": {
                "type": "simple",
                "time_frequency": "1YS",
                "aggregation": "mean",
                "unit_conversion": "none",
                "rolling_years": 10
            },
            "plot": {
                "color": "darkgreen",
                "ylabel": "Mean Tree Cover (%)",
                "cmap": "Greens",
                "label": "Tree Cover (%)"
            },
            "toad": {
                "shift":{
                     "shift_method": "FilteredASDETECT",
                     "shift_direction": "negative",
                     "shift_selection": "local",
                     "shift_params": {
                        "window_indices": 30,
                        "min_rel_change": 0.10,
                        "min_abs_change": 5.0
                        }
                    },
                "cluster":{
                    "cluster_method": "SpaceTimeDBSCAN",
                    "optimize": true,
                    "optimize_objective": "mean_spatial_autocorrelation",
                    "optimize_params": {
                    "spatial_eps": [300.0,2000.0],
                    "temporal_eps": [1.5,4.0],
                    "min_samples": [20,25] },
                    "optimize_n_trials": 3000}
            }
        },
        "AnnualRainfall": {
            "preprocessing": {
                "type": "simple",
                "time_frequency": "1YS",
                "aggregation": "sum",
                "unit_conversion": "flux_to_annual_total",
                "rolling_years": 10
            },
            "plot": {
                "color": "royalblue",
                "ylabel": "Mean Annual Rainfall ($mm$)",
                "cmap": "Blues",
                "label": "Annual Rainfall ($mm$)"
            },
            "toad": {
                "shift":{
                     "shift_method": "ASDETECT",
                     "shift_direction": "negative",
                     "shift_selection": "local" },
                "cluster":{
                    "cluster_method": "SpaceTimeDBSCAN",
                    "optimize": true,
                    "optimize_objective": "mean_spatial_autocorrelation",
                    "optimize_params": {
                    "spatial_eps": [300.0,1000.0],
                    "temporal_eps": [0.2,0.8],
                    "min_samples": [9,50] },
                    "optimize_n_trials": 3000}
            }
        }
    }
}